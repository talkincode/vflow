{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@video-compose/protocol": ["./packages/protocol/src/index.ts"],
      "@video-compose/domain": ["./packages/domain/src/index.ts"],
      "@video-compose/client": ["./packages/client/src/index.ts"],
      "@video-compose/api": ["./apps/api/src/index.ts"],
      "@video-compose/web/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}

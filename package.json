{
  "name": "video-compose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-native declarative video composition workspace",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "deploy": "npm run build && wrangler deploy --config apps/api/wrangler.jsonc",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7",
    "wrangler": "4.151.0"
  }
}

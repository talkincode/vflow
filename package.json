{
  "name": "video-compose",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agent-native declarative video composition workspace",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "eslint": "^9.0.0"
  }
}
